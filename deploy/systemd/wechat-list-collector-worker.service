[Unit]
Description=WeChat List Collector Worker
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/wechat-list-collector
EnvironmentFile=/etc/wechat-list-collector.env
ExecStart=/opt/wechat-list-collector/.venv/bin/wechat-list-collector --config /etc/wechat-list-collector.toml worker
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
